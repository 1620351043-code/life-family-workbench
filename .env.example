NODE_ENV=production
PORT=3100
DATABASE_URL=postgres://life_app:REPLACE_ME@127.0.0.1:5432/life

# Tencent COS private bucket; never commit real values.
LIFE_COS_BUCKET=life-prod-REPLACE_ME
LIFE_COS_REGION=ap-guangzhou
LIFE_COS_SECRET_ID=REPLACE_ME
LIFE_COS_SECRET_KEY=REPLACE_ME
LIFE_COS_LIVE_SMOKE=false

# HttpOnly cookie must be Secure behind HTTPS.
LIFE_SESSION_COOKIE_NAME=life_session
LIFE_SESSION_COOKIE_SECURE=true

# Password reset delivery adapter. The endpoint receives recipient, reset_url
# and expires_at as JSON. Keep bearer token server-only when the provider needs it.
LIFE_PUBLIC_APP_URL=https://life.example.com/
LIFE_PASSWORD_RESET_DELIVERY_ENDPOINT=https://mailer.example.com/password-reset
# LIFE_PASSWORD_RESET_DELIVERY_BEARER_TOKEN=REPLACE_ME

# Optional household AI secret mapping. Values are server-only.
# LIFE_AI_SECRET_MAP={"family-a-key":"REPLACE_ME"}
