[Unit]
Description=Life staging health check
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/life/releases/current
EnvironmentFile=/etc/life/staging-health.env
ExecStart=/usr/bin/npm run health:check
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/life/staging-imports
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
