# B-011 staging only. Copy to /etc/life/staging.env with mode 0600.
# Never commit the real database password or delivery bearer token.
NODE_ENV=staging
LIFE_DEPLOYMENT_ENV=staging
PORT=3100
DATABASE_URL=postgres://life_app:REPLACE_ME@127.0.0.1:5432/life_staging

LIFE_SESSION_COOKIE_NAME=life_session
LIFE_SESSION_COOKIE_SECURE=true
LIFE_PUBLIC_APP_URL=https://staging-life.example.com/
LIFE_PASSWORD_RESET_DELIVERY_ENDPOINT=https://mailer.example.com/password-reset
# LIFE_PASSWORD_RESET_DELIVERY_BEARER_TOKEN=REPLACE_ME

# B-011 deliberately keeps Tencent COS outside this staging identity slice.
LIFE_IMPORT_STORAGE_ROOT=/var/lib/life/staging-imports
