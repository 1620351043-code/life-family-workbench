[Unit]
Description=Life staging API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=life
Group=life
WorkingDirectory=/srv/life/releases/current
EnvironmentFile=/etc/life/staging.env
ExecStart=/usr/bin/npm run api:start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/life/staging-imports
UMask=0077

[Install]
WantedBy=multi-user.target
