# I-011 health check configuration. Copy to /etc/life/staging-health.env with
# mode 0600 root:root. This file must use a dedicated monitoring/database
# connection that can read global queue state under FORCE RLS; never reuse a
# low-privilege application connection and never commit real values.
LIFE_HEALTH_DATABASE_URL=postgres://life_health:REPLACE_ME@127.0.0.1:5432/life_staging
LIFE_HEALTH_API_URL=http://127.0.0.1:3100
LIFE_HEALTH_TLS_HOST=staging-life.example.com
LIFE_HEALTH_TLS_PORT=443
LIFE_HEALTH_STORAGE_ROOT=/var/lib/life/staging-imports

# Optional thresholds. Keep the health check quiet when the environment is
# healthy; alerts are only meaningful when they are not constant.
LIFE_HEALTH_QUEUE_STALE_MINUTES=30
LIFE_HEALTH_QUEUE_FAILED_CRITICAL=5
LIFE_HEALTH_QUEUE_PENDING_CRITICAL=500
LIFE_HEALTH_RETENTION_CRITICAL=20
LIFE_HEALTH_DISK_WARN_PERCENT=80
LIFE_HEALTH_DISK_CRITICAL_PERCENT=90
LIFE_HEALTH_CERT_WARN_DAYS=14
LIFE_HEALTH_CERT_CRITICAL_DAYS=7

# Optional alert webhook. It must use HTTPS and a Bearer token; leave unset
# until a notification channel is available. Systemd journal remains the
# baseline failure record even when no webhook is configured.
# LIFE_HEALTH_ALERT_WEBHOOK_URL=https://alerts.example.com/life/health
# LIFE_HEALTH_ALERT_WEBHOOK_TOKEN=REPLACE_ME
