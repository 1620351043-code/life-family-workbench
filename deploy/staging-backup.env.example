# Keep the real file root:root and chmod 0600. DATABASE_URL is loaded separately
# from /etc/life/staging-migration.env; do not duplicate it here.
LIFE_BACKUP_CONFIRM=I_UNDERSTAND_THIS_CREATES_ENCRYPTED_POSTGRES_BACKUPS
LIFE_BACKUP_ROOT=/var/backups/life/staging/postgres

# Dedicated rclone bucket/prefix. Do not point at a bucket root or a shared prefix.
LIFE_BACKUP_RCLONE_REMOTE=life-cos:life-backups/staging/postgres
LIFE_BACKUP_GPG_PASSPHRASE_FILE=/etc/life/staging-backup.gpg-passphrase
LIFE_BACKUP_GNUPG_HOME=/var/lib/life/staging-backup-gnupg

# Defaults: keep seven local daily restore points and 35 remote daily restore points.
LIFE_BACKUP_LOCAL_RETENTION_DAYS=7
LIFE_BACKUP_REMOTE_RETENTION_DAYS=35
LIFE_BACKUP_PRUNE_REMOTE=true
